{
  "name": "backquant-terminal-desktop",
  "productName": "BackQuant Terminal",
  "version": "0.3.4",
  "description": "BackQuant Terminal",
  "author": "BackQuant",
  "private": true,
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test app/urls.test.js app/update.test.js app/crash.test.js",
    "dist": "electron-builder --mac dir --universal --publish never && bash build/make-dmg.sh",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.0.12",
    "pe-library": "^1.0.1",
    "resedit": "^2.0.3"
  },
  "build": {
    "appId": "com.backquant.desktop",
    "productName": "BackQuant Terminal",
    "copyright": "BackQuant",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "!app/**/*.test.js"
    ],
    "extraResources": [
      {
        "from": "build/Assets.car",
        "to": "Assets.car"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "backquant",
        "repo": "backquant-terminal-desktop",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dir",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "CFBundleIconName": "AppIcon"
      },
      "artifactName": "BackQuant-Terminal.${ext}"
    },
    "afterPack": "build/after-pack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon-win.ico",
      "artifactName": "BackQuant-Terminal-Setup.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BackQuant Terminal",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  }
}
